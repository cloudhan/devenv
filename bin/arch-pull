#!/usr/bin/env bash
# arch-pull — pull a specific CPU arch under a new tag; do not retag the local native image.
#
# Usage:
#   arch-pull IMAGE[:TAG] [ARCH]
#
# ARCH defaults to x86_64. TAG defaults to latest.
# Examples:
#   arch-pull nvcr.io/nvidia/pytorch:26.06-py3 aarch64
#   arch-pull nvcr.io/nvidia/pytorch:26.06-py3          # ARCH=x86_64
#   arch-pull nvcr.io/nvidia/pytorch aarch64            # TAG=latest

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: arch-pull IMAGE[:TAG] [ARCH]

Pull IMAGE for ARCH and tag it as IMAGE:TAG-ARCH.
Does not change the local IMAGE:TAG (native) name.

ARCH defaults to x86_64. TAG defaults to latest.

  arch-pull nvcr.io/nvidia/pytorch:26.06-py3 aarch64
  arch-pull nvcr.io/nvidia/pytorch:26.06-py3
  arch-pull nvcr.io/nvidia/pytorch aarch64
EOF
}

die() { echo "arch-pull: $*" >&2; exit 1; }

is_arch() {
  case "$1" in
    x86_64|amd64|x64|aarch64|arm64) return 0 ;;
    *) return 1 ;;
  esac
}

normalize_arch() {
  # stdout: <cli_suffix> <docker_arch> <platform>
  case "$1" in
    x86_64|amd64|x64) echo "x86_64 amd64 linux/amd64" ;;
    aarch64|arm64)    echo "aarch64 arm64 linux/arm64" ;;
    *) die "unsupported ARCH '$1' (use x86_64 or aarch64)" ;;
  esac
}

parse_image_tag() {
  # IMAGE[:TAG] -> sets PARSE_IMAGE PARSE_TAG. TAG defaults to latest.
  # Tag is the colon in the last path component only (so registry:5000/name works).
  local ref="$1"
  local last="${ref##*/}"
  if [[ "$ref" == *@* ]]; then
    die "digest refs are not supported; pass IMAGE[:TAG]"
  fi
  if [[ "$last" == *:* ]]; then
    PARSE_TAG="${ref##*:}"
    PARSE_IMAGE="${ref%:*}"
  else
    PARSE_IMAGE="$ref"
    PARSE_TAG="latest"
  fi
  [[ -n "$PARSE_IMAGE" && -n "$PARSE_TAG" ]] || die "invalid image ref '$ref'"
}

ARCH="x86_64"
IMAGE_REF=""

case "${1:-}" in
  -h|--help|"") usage; [[ -n "${1:-}" ]] || exit 2; exit 0 ;;
esac

if [[ "$#" -eq 1 ]]; then
  IMAGE_REF="$1"
elif [[ "$#" -eq 2 ]]; then
  IMAGE_REF="$1"
  is_arch "$2" || die "last argument is not a known ARCH: $2 (use x86_64 or aarch64)"
  ARCH="$2"
else
  usage >&2
  exit 2
fi

read -r ARCH_SUFFIX DOCKER_ARCH PLATFORM <<<"$(normalize_arch "$ARCH")"
parse_image_tag "$IMAGE_REF"
IMAGE="$PARSE_IMAGE"
TAG="$PARSE_TAG"
SRC="${IMAGE}:${TAG}"
DST="${IMAGE}:${TAG}-${ARCH_SUFFIX}"

command -v docker >/dev/null || die "docker not found"
docker buildx imagetools inspect --help >/dev/null 2>&1 || die "docker buildx imagetools is required"

echo "arch-pull: src=$SRC arch=$ARCH_SUFFIX platform=$PLATFORM"
echo "arch-pull: dst=$DST  (local $SRC left unchanged)"

DIGEST="$(
  docker buildx imagetools inspect --format '{{json .}}' "$SRC" \
    | python3 -c '
import json, sys

want = sys.argv[1]
data = json.load(sys.stdin)

def pick(d, *names):
    if not isinstance(d, dict):
        return None
    lower = {str(k).lower(): v for k, v in d.items()}
    for n in names:
        if n.lower() in lower:
            return lower[n.lower()]
    return None

manifest = pick(data, "manifest") or {}
manifests = pick(manifest, "manifests") or []

for m in manifests:
    plat = pick(m, "platform") or {}
    os_ = pick(plat, "os")
    arch = pick(plat, "architecture")
    variant = pick(plat, "variant") or ""
    if os_ != "linux" or arch != want:
        continue
    if arch == "unknown":
        continue
    # skip attestation manifests
    ann = pick(m, "annotations") or {}
    if isinstance(ann, dict) and any(
        str(v) == "attestation-manifest" for v in ann.values()
    ):
        continue
    digest = pick(m, "digest")
    if digest:
        print(digest)
        sys.exit(0)

# Single-arch image: no platform list. Caller verifies after pull.
digest = pick(manifest, "digest") or pick(data, "digest")
if digest:
    print(digest)
    sys.exit(0)

sys.exit(1)
' "$DOCKER_ARCH"
)" || die "could not inspect $SRC (login to the registry if it is private)"

[[ -n "$DIGEST" ]] || die "no digest found for $SRC ($PLATFORM)"

echo "arch-pull: digest=$DIGEST"
docker pull --platform "$PLATFORM" "${IMAGE}@${DIGEST}"
docker tag "${IMAGE}@${DIGEST}" "$DST"

GOT="$(docker inspect --format '{{.Architecture}}' "$DST" 2>/dev/null || true)"
[[ "$GOT" == "$DOCKER_ARCH" ]] || die "pulled $DST is arch='$GOT', expected '$DOCKER_ARCH'"

echo "arch-pull: done"
docker inspect --format '{{.Architecture}} {{.Id}}' "$DST"
if docker image inspect "$SRC" >/dev/null 2>&1; then
  echo "arch-pull: native tag still: $SRC -> $(docker inspect --format '{{.Architecture}} {{.Id}}' "$SRC")"
fi
