#!/usr/bin/env python3
"""Allocate an oversubscribed Slurm node until at most Sunday 08:00 UTC."""

import argparse
from contextlib import contextmanager
import datetime as dt
import math
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
from zoneinfo import ZoneInfo


QOS = "oversubscribe"
ZONE = dt.timezone.utc


def duration_seconds(value):
    """Parse Slurm's minutes, [days-]HH:MM:SS, and unlimited values."""
    value = value.strip()
    if value.upper() in {"UNLIMITED", "INFINITE"}:
        return math.inf
    if not re.fullmatch(r"(?:\d+-)?\d+(?::\d+){0,2}", value):
        raise ValueError(f"cannot interpret Slurm time limit {value!r}")
    days, clock = value.split("-", 1) if "-" in value else ("0", value)
    parts = [int(part) for part in clock.split(":")]
    if len(parts) == 1:
        seconds = parts[0] * (3600 if "-" in value else 60)
    elif len(parts) == 2:
        seconds = parts[0] * (3600 if "-" in value else 60) + parts[1] * (60 if "-" in value else 1)
    else:
        seconds = parts[0] * 3600 + parts[1] * 60 + parts[2]
    return int(days) * 86400 + seconds


def sunday_cutoff(now):
    local = now.astimezone(ZONE)
    date = local.date() + dt.timedelta(days=(6 - local.weekday()) % 7)
    cutoff = dt.datetime.combine(date, dt.time(8), tzinfo=ZONE)
    if cutoff <= local:
        cutoff += dt.timedelta(days=7)
    return cutoff


def allocation_command(node, partition, minutes, cutoff, post_init):
    # The srun client receives TZ=UTC, matching this UTC deadline.
    deadline = cutoff.strftime("%Y-%m-%dT%H:%M:%S")
    return ["srun", f"--job-name=alloc-ovb-{node}", f"--nodelist={node}",
            f"--partition={partition}", f"--qos={QOS}", "--oversubscribe",
            "--nodes=1", "--ntasks=1", f"--time={minutes}", "--time-min=1",
            f"--deadline={deadline}", "--pty", "bash", "-c",
            'if [ -n "$1" ]; then bash -- "$1" || exit $?; fi; exec bash -l',
            "alloc-ovb", post_init]


def validated_allocation(node, partition, limit, requested_cutoff, post_init, environment):
    """Discover stricter site deadlines through a no-allocation Slurm preflight."""
    cutoff = requested_cutoff
    for _ in range(3):
        now = dt.datetime.now(ZONE)
        # Leave one minute for preflight/submission latency at a hard deadline.
        minutes = math.floor(min(limit, (cutoff - now).total_seconds() - 60) / 60)
        if minutes < 1:
            raise ValueError("less than one usable minute is available before the cutoff")
        command = allocation_command(node, partition, minutes, cutoff, post_init)
        result = subprocess.run(
            [command[0], "--test-only", *command[1:]], env=environment,
            text=True, capture_output=True, timeout=60,
        )
        if result.returncode == 0:
            return command, minutes, cutoff, now
        message = (result.stderr + "\n" + result.stdout).strip()
        match = re.search(
            r"weekly reboot cutoff (\d{4}-\d{2}-\d{2} \d{2}:\d{2}) "
            r"\S+ \(([^)]+)\)", message,
        )
        if match:
            site_cutoff = dt.datetime.strptime(match[1], "%Y-%m-%d %H:%M").replace(
                tzinfo=ZoneInfo(match[2]),
            ).astimezone(ZONE)
            if now < site_cutoff < cutoff:
                cutoff = site_cutoff
                continue
        # Do not retry other policy/authentication/resource errors as allocations.
        raise ValueError(f"Slurm preflight failed: {message or f'exit {result.returncode}'}")
    raise ValueError("Slurm's cutoff changed repeatedly; no allocation was submitted")


def query(argv, environment):
    result = subprocess.run(argv, env=environment, text=True, capture_output=True, timeout=60)
    if result.returncode:
        raise ValueError(f"{shlex.join(argv)} failed: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout


def fields(line):
    return dict(re.findall(r"(?:^|\s)(\w+)=([^\s]+)", line))


@contextmanager
def allocated_tab_name(hostname):
    """Temporarily name the calling tab, restoring its previous display name."""
    target = None
    for prefix, executable in (("HERDIST", "herdist"), ("HERDR", "herdr")):
        pane_id = os.environ.get(f"{prefix}_PANE_ID", "").strip()
        if os.environ.get(f"{prefix}_ENV") != "1" or not pane_id:
            continue
        binary = shutil.which(os.environ.get(f"{prefix}_BIN_PATH", executable))
        if not binary:
            binary = shutil.which(executable)
        if binary:
            target = (binary, pane_id)
        else:
            print(f"alloc-ovb: cannot rename tab: {executable} is unavailable", file=sys.stderr)
        break

    def api_command(group, *args):
        result = subprocess.run(
            [target[0], group, *args], text=True, capture_output=True, timeout=5,
        )
        if result.returncode:
            raise ValueError(result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}")
        return result.stdout

    def tab_label(tab_id):
        tab = json.loads(api_command("tab", "get", tab_id))["result"]["tab"]
        if tab["tab_id"] != tab_id or not isinstance(tab["label"], str):
            raise ValueError("tab inspection returned an unexpected tab or label")
        return tab["label"]

    errors = (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError)
    restore = None
    if target:
        try:
            pane = json.loads(api_command("pane", "get", target[1]))["result"]["pane"]
            if pane["pane_id"] != target[1]:
                raise ValueError("pane inspection returned a different pane")
            tab_id = pane["tab_id"]
            previous = tab_label(tab_id)
            # Retain the restore target even if a rename times out after applying.
            restore = (tab_id, previous)
            api_command("tab", "rename", tab_id, hostname)
        except errors as error:
            print(f"alloc-ovb: cannot rename tab: {error}", file=sys.stderr)
    try:
        yield
    finally:
        if restore is not None:
            try:
                # Preserve any name the user changes during the allocation.
                if tab_label(restore[0]) == hostname:
                    api_command("tab", "rename", *restore)
            except errors as error:
                print(f"alloc-ovb: cannot restore tab name: {error}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(
        description="Query live Slurm limits, allocate an oversubscribed node, then open a shell. "
        "The allocation ends no later than next Sunday 08:00 UTC, or an earlier cluster reboot cutoff. "
        "Run on the cluster frontend; Python 3.9+ and Slurm tools are required.",
    )
    parser.add_argument("--dry-run", action="store_true", help="query limits, preflight Slurm policy, and print the request without allocating")
    parser.add_argument("node", help="one exact node hostname, e.g. ipp2-0038")
    parser.add_argument("post_init", nargs="?", help="shell script accessible on the node; run with bash before the interactive shell")
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", args.node):
        parser.error("node must be one hostname, not a Slurm range or list")
    for command in ("sinfo", "scontrol", "sacctmgr", "srun"):
        if not shutil.which(command):
            parser.error(f"{command} is missing; run this helper on the cluster frontend")

    # Request a new allocation, never a step in an inherited (possibly expired) job.
    environment = {key: value for key, value in os.environ.items()
                   if not key.startswith(("SLURM_", "SLURMD_", "SRUN_"))}
    # Slurm parses absolute deadlines in the client timezone; force UTC so
    # every user submits the same instant regardless of their local TZ or DST.
    environment["TZ"] = "UTC"
    post_init = str(Path(args.post_init).expanduser().absolute()) if args.post_init else ""
    if post_init and Path(post_init).exists() and not Path(post_init).is_file():
        parser.error("post-init must be a file")

    qos_rows = query(["sacctmgr", "-nP", "show", "qos", QOS, "format=Name,MaxWall,Flags"], environment)
    qos_limit = None
    qos_flags = set()
    for line in qos_rows.splitlines():
        columns = line.strip().split("|")
        if len(columns) >= 3 and columns[0] == QOS:
            qos_limit = duration_seconds(columns[1]) if columns[1] else math.inf
            qos_flags = set(columns[2].split(","))
            break
    if qos_limit is None:
        raise ValueError("Slurm did not return the oversubscribe QoS; cannot determine a safe duration")

    names = query(["sinfo", "-N", "-h", "-n", args.node, "-o", "%P"], environment)
    partitions = sorted({name.strip().rstrip("*") for name in names.splitlines()
                         if name.strip().startswith("ovsb/")})
    candidates = []
    for partition in partitions:
        metadata = query(["scontrol", "show", "partition", partition, "-o"], environment)
        info = next((fields(line) for line in metadata.splitlines()
                     if fields(line).get("PartitionName") == partition), {})
        if not info or info.get("State") != "UP":
            continue
        allowed = set(info.get("AllowQos", "ALL").split(","))
        denied = set(info.get("DenyQos", "").split(","))
        if ("ALL" not in allowed and QOS not in allowed) or QOS in denied:
            continue
        partition_limit = duration_seconds(info["MaxTime"])
        limits = [qos_limit, partition_limit]
        # Slurm permits a job QoS to override the partition's wall limit only with this flag.
        if "PartitionTimeLimit" in qos_flags:
            limits = [qos_limit]
        partition_qos = info.get("QoS", "N/A")
        if partition_qos not in {"N/A", "(null)", QOS}:
            data = query(["sacctmgr", "-nP", "show", "qos", partition_qos, "format=Name,MaxWall"], environment)
            found = False
            for row in data.splitlines():
                columns = row.strip().split("|")
                if len(columns) >= 2 and columns[0] == partition_qos:
                    limits.append(duration_seconds(columns[1]) if columns[1] else math.inf)
                    found = True
            if not found:
                raise ValueError(f"cannot determine partition QoS limit for {partition_qos}")
        candidates.append((min(limits), partition))
    if not candidates:
        raise ValueError(f"{args.node} has no UP ovsb/ partition allowing {QOS}")
    limit, partition = max(candidates)
    requested_cutoff = sunday_cutoff(dt.datetime.now(ZONE))
    command, minutes, cutoff, now = validated_allocation(
        args.node, partition, limit, requested_cutoff, post_init, environment,
    )
    print(f"Node: {args.node}\nPartition: {partition}\nQoS: {QOS}")
    print(f"Maximum requested duration: {minutes} minutes")
    print(f"Sunday cutoff: {requested_cutoff:%Y-%m-%d %H:%M %Z}")
    if cutoff < requested_cutoff:
        print(f"Cluster reboot cutoff: {cutoff:%Y-%m-%d %H:%M %Z} (earlier limit applies)")
    print(f"Expiry if started now: {(now + dt.timedelta(minutes=minutes)).astimezone(ZONE):%Y-%m-%d %H:%M %Z}")
    print("Slurm preflight passed; one minute is reserved for submission at the cutoff.")
    print("Queued jobs may receive a shorter duration to finish by the cutoff.")
    print(shlex.join(command), flush=True)
    if not args.dry_run:
        # Keep this frontend process alive so cleanup can restore the tab name.
        with allocated_tab_name(args.node):
            result = subprocess.run(command, env=environment)
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.TimeoutExpired) as error:
        sys.exit(f"alloc-ovb: {error}")
    except KeyboardInterrupt:
        sys.exit(130)
