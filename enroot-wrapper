#!/bin/bash

export ENROOT_CACHE_PATH=/tmp
export WORKSPACES=$(realpath ~/workspaces)

docker_image=nvidia/pytorch:26.08-py3
enroot_image=${docker_image//[\/:]/+}

enroot load docker://nvcr.io/${docker_image}

set -ex

enroot start -r --rw \
    --mount /home:/home \
    --mount "$WORKSPACES:/workspace" \
    --mount "$WORKSPACES:$WORKSPACES" \
    --mount /mnt:/mnt \
    "${enroot_image}" \
    bash -i -c '/workspace/devenv/bootstrap-in-enroot.sh && exec fish -i'
